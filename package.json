    "src",
    "templates",
    "schemas"
  ],
  "keywords": [
    "cmake",
    "template",
    "scaffold",
    "boilerplate",
    "cli",
    "cpp",
    "project-generator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nana7mi-swjtu/cmake-template.git"
  },
  "homepage": "https://github.com/Nana7mi-swjtu/cmake-template#readme",
  "bugs": {
