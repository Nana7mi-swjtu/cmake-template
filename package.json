{
  "name": "cmake-template",
  "version": "0.1.0",
  "private": true,
  "description": "交互式 CMake 项目模板工具：用可自定义的模板在任意路径生成打开即用的 CMake 工程",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ctpl": "./bin/ctpl.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "files": [
    "bin",
    "src",
    "templates",
    "schemas"
  ]
}
