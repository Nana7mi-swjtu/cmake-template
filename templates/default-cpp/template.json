{
  "schemaVersion": 1,
  "id": "default-cpp",
  "name": "标准 C++ 工程",
  "version": "0.5.1",
  "default": true,
  "variables": [
    {
      "key": "cppStandard",
      "prompt": "C++ 标准",
      "type": "select",
      "choices": ["11", "14", "17", "20", "23"],
      "default": "11"
    }
  ],
  "optionalGroups": [
    {
      "id": "tests",
      "label": "单元测试（CTest + tests/CMakeLists.txt）",
      "default": false,
      "paths": ["tests"],
      "files": ["tests/**"],
      "defines": { "withTests": true }
    }
  ],
  "cmake": {
    "minVersion": "3.20",
    "buildDir": "build",
    "standard": "11",
    "generator": "Ninja"
  }
}
